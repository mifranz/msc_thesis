directory <- "/Users/michafranz/Desktop/untitled folder"
csv_file <- list.files(directory, pattern = "\\.csv$", full.names = TRUE)
download_links <- readr::read_csv(csv_file, col_names = FALSE)
names(download_links) <- "download_link"
tif_files <- list.files(path = directory, pattern = "\\.tif$", full.names = TRUE)
# if files are already downloaded. skip download (e.g. if you add some files manually and want to rerun the merge function)
if (length(tif_files) > 1) {
return()
} else {
# download all files from csv link
# link <- download_links$download_link[1] # for manual debugging
for (link in download_links$download_link) {
file_name <- basename(link)
destination <- file.path(directory, file_name)
tryCatch({
response <- httr::GET(link)
if (httr::status_code(response) == 200) {
httr::GET(link, httr::write_disk(destination, overwrite = TRUE))
message("Downloaded: ", file_name)
} else {
# Try alternative years: 2024 first, then 2022
alt_years <- c("2024", "2022")
downloaded <- FALSE
for (year in alt_years) {
alt_link <- gsub("2023", year, link)
alt_file_name <- basename(alt_link)
alt_destination <- file.path(directory, alt_file_name)
alt_response <- httr::GET(alt_link)
if (httr::status_code(alt_response) == 200) {
httr::GET(alt_link, httr::write_disk(destination, overwrite = TRUE))
message("Downloaded (alternate ", year, "): ", alt_file_name)
downloaded <- TRUE
break
}
}
if (!downloaded) {
message("Skipped (HTTP ", httr::status_code(response), "): ", file_name)
}
}
}, error = function(e) {
message("Error downloading: ", file_name, " - ", e$message)
})
}
}
